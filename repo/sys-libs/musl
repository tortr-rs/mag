desc: the libc everything in Chamesle is built against. its Makefile needs GNU make, which has to be on the machine that builds
version: 1.2.5
url: https://musl.libc.org/releases/musl-${version}.tar.gz
sha256: a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4
deps:
steps:
	CC=clang ./configure --prefix=$PREFIX --syslibdir=/lib LIBCC="$(clang -rtlib=compiler-rt -print-libgcc-file-name)"
	gmake -j$JOBS
	gmake DESTDIR=$DESTDIR install

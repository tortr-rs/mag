desc: small SSH server and client
version: 2026.94
url: https://matt.ucc.asn.au/dropbear/releases/dropbear-${version}.tar.bz2
sha256: e098034a843699200c8c977a991fff73159735bf795d5f72ef672c41a6b1ae81
deps: sys-libs/zlib
steps:
	./configure --prefix=$PREFIX --disable-pam --disable-lastlog --disable-utmp --disable-wtmp --disable-zlib
	make -j$JOBS PROGRAMS="dropbear dbclient dropbearkey scp"
	make DESTDIR=$DESTDIR PROGRAMS="dropbear dbclient dropbearkey scp" install

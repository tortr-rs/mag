desc: pkg-config without the GNU
version: 3.0.10
url: https://distfiles.ariadne.space/pkgconf/pkgconf-${version}.tar.xz
sha256: 9371b2f6372da574d4c6dc96fe9b1463037bcf6afcb6671c1555afde7b17e2de
deps: sys-libs/musl
steps:
	./configure --prefix=$PREFIX --disable-shared
	make -j$JOBS
	make DESTDIR=$DESTDIR install
	ln -s pkgconf $DESTDIR$PREFIX/bin/pkg-config

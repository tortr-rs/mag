desc: WPA/WPA2/WPA3 supplicant for wifi
version: 2.12
url: https://w1.fi/releases/wpa_supplicant-${version}.tar.gz
sha256: 08e23937e16d0155e55cab2b51f51fbe10d80a1aa91c4e15442645059b737ef6
deps: net-libs/libnl dev-libs/libressl dev-build/pkgconf
steps:
	cd wpa_supplicant
	cp defconfig .config
	echo CONFIG_CTRL_IFACE_DBUS_NEW=n >>.config
	echo CONFIG_READLINE=n >>.config
	make -j$JOBS
	install -D wpa_supplicant $DESTDIR$PREFIX/sbin/wpa_supplicant
	install -D wpa_cli $DESTDIR$PREFIX/sbin/wpa_cli
	install -D wpa_passphrase $DESTDIR$PREFIX/bin/wpa_passphrase

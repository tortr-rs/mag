desc: the Linux kernel and its modules, prebuilt, 6.18 LTS
version: 6.18.63
url: https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/linux-lts-${version}-r0.apk
sha256: 6709cb3a85ce874efb85abd738f3232bfbc859a474f8b122e6ad1e3d5a25f99d
deps:
steps:
	tar -xzf linux-lts-*.apk 2>/dev/null || true
	kv=$(ls lib/modules)
	install -Dm644 boot/vmlinuz-lts $DESTDIR/boot/vmlinuz-$kv
	install -Dm644 boot/config-$kv $DESTDIR/boot/config-$kv
	install -Dm644 boot/System.map-$kv $DESTDIR/boot/System.map-$kv
	mkdir -p $DESTDIR/lib/modules
	cp -R lib/modules/$kv $DESTDIR/lib/modules/

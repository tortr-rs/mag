desc: bsdtar, bsdcpio and the library under them; the tar of this system
version: 3.8.11
url: https://github.com/libarchive/libarchive/releases/download/v${version}/libarchive-${version}.tar.xz
sha256: a3dc0872b1b39da34dc18ef1b944f0f11ffd37425d70ae04be679279f1cf43d2
deps: sys-libs/zlib app-arch/xz app-arch/zstd app-arch/bzip2 app-arch/lz4 dev-libs/libressl
steps:
	./configure --prefix=$PREFIX --disable-shared --without-xml2 --without-expat --without-iconv --without-nettle
	make -j$JOBS
	make DESTDIR=$DESTDIR install
	ln -s bsdtar $DESTDIR$PREFIX/bin/tar
	ln -s bsdcpio $DESTDIR$PREFIX/bin/cpio
